# Example .env.local file
# Copy this file to .env.local and fill in the values.

# Database
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="supersecret"
NEXTAUTH_URL="http://localhost:3000"

# Google AI
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="your-azure-storage-connection-string"
AZURE_STORAGE_CONTAINER_NAME="your-azure-storage-container-name"

# Social Media APIs
# Facebook/Instagram (Meta)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
INSTAGRAM_CLIENT_ID="your-instagram-client-id"  # Same as Facebook App ID for Instagram Business
INSTAGRAM_CLIENT_SECRET="your-instagram-client-secret"  # Same as Facebook App Secret

# TikTok (Future)
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"

# Encryption for OAuth tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="15a7567b9c7e0cc88e0d1ff5afc527b6765f8cf18a39092b54591225dcb9ef3a"
