# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/studio_dev"

# NextAuth Configuration
# Generate a secure random string for production
# You can generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Azure Storage (Optional - for file uploads)
# Get these from your Azure Storage account
AZURE_STORAGE_CONNECTION_STRING="your-azure-storage-connection-string"
AZURE_STORAGE_CONTAINER_NAME="your-container-name"

# Google AI API (Optional - for AI features)
# Get this from Google AI Studio: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY="your-google-ai-api-key"
GOOGLE_GENAI_API_KEY="your-google-ai-api-key"

# Socket Server (Optional - for real-time features)
NEXT_PUBLIC_SOCKET_SERVER_URL="http://localhost:3001"

# Development settings
NODE_ENV="development"
