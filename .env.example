# Society+ Environment Variables
# Copy this file to .env (local dev) or set these in your Vercel/Railway dashboard for production.
# NEVER commit .env — only .env.example is committed.

# ── Database ──────────────────────────────────────────────
# Local dev: postgresql://postgres:postgres@localhost:5433/studiodb
# Production: get from Neon / Supabase / Railway
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Auth (NextAuth) ───────────────────────────────────────
# Must match your deployed URL exactly (no trailing slash)
NEXTAUTH_URL=https://your-app.vercel.app
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ── Hub App Integration ───────────────────────────────────
# Shared secret between Society+ and any Citinet hub that installs this app.
# Set the same value in the hub's admin panel as the "App Key".
HUB_APP_KEY=your-strong-random-key-here

# ── File Storage (Azure Blob or Cloudflare R2) ────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=media

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=society-plus-uploads
R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── AI (Gemini + Cloudflare Workers AI fallback) ─────────
GOOGLE_AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Email (SMTP) ──────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
