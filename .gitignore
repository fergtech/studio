.env
.env.local
.env.production
.env.development
.env.example

# next.js
/.next/
/out/

# docker
docker-compose.yml

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

