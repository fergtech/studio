  SPONSOR
  MENTOR
}

enum DebateSide {
  PRO
  CON
}

enum NotificationType {
  DIRECT_MESSAGE
  FOLLOW
  INITIATIVE_INVITE
  GOAL_COMPLETED
  MILESTONE_REACHED
}

// A searchable geographic area (e.g., city, neighborhood)
model Area {
  id        String   @id @default(cuid())
  name      String   // e.g., "Downtown", "The Fan District"
  city      String   // e.g., "Richmond"
  state     String   // e.g., "VA"
  country   String   // e.g., "USA"
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@index([city])
}