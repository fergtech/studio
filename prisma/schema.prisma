generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  name                  String?
  image                 String?
  dateCreated           DateTime               @default(now())
  bio                   String?
  skills                String[]               @default([])
  interests             String[]               @default([])
  profession            String?
  organization          String?
  institution           String?
  bannerImageUrl        String?
  gender                String?
  username              String?                @unique
  websites              String[]               @default([])
  primaryIntent         String?
  location              String?
  city                  String?
  latitude              Float?
  longitude             Float?
  showLocation          Boolean                @default(true)
  lastActiveAt          DateTime?
  enableLocalNews       Boolean                @default(true)
  newsRadius            Int?                   @default(25)
  newsTypes             String[]               @default(["local", "community", "government"])
  assignedActions       Action[]               @relation("AssigneeOfAction")
  completedActionsBy    Action[]               @relation("CompleterOfAction")
  createdActions        Action[]               @relation("CreatorOfAction")
  receivedChatMessages  ChatMessage[]          @relation("ReceiverOfChatMessage")
  sentChatMessages      ChatMessage[]          @relation("SenderOfChatMessage")
  comments              Comment[]              @relation("UserComments")
  debateArguments       DebateArgument[]
  debateArgumentVotes   DebateArgumentVote[]
  createdDebateTopics   DebateTopic[]
  debateVotes           DebateVote[]
  createdGeneralPosts   GeneralPost[]          @relation("CreatorOfGeneralPost")
  generalPostComments   GeneralPostComment[]
  generalPostLikes      GeneralPostLike[]
  generalPostShares     GeneralPostShare[]
  ownedGoals            Goal[]                 @relation("OwnerOfGoal")
  hotTakeParticipations HotTakeParticipant[]   @relation("UserHotTakeParticipations")
  championedIdeas       Idea[]                 @relation("ChampionedIdeaBy")
  createdIdeas          Idea[]                 @relation("CreatorOfIdea")
  ideaComments          IdeaComment[]
  ideaLikes             IdeaLike[]
  ideaShares            IdeaShare[]
  createdInitiatives    Initiative[]           @relation("CreatorOfInitiative")
  initiativeMemberships InitiativeMembership[]
  championedIssues      Issue[]                @relation("ChampionedIssueBy")
  createdIssues         Issue[]                @relation("CreatorOfIssue")
  issueComments         IssueComment[]
  issueLikes            IssueLike[]
  issueShares           IssueShare[]
  createdMilestones     Milestone[]            @relation("CreatorOfMilestone")
  newsActions           NewsAction[]           @relation("UserNewsActions")
  notifications         Notification[]         @relation("UserNotifications")
  posts                 Post[]                 @relation("UserPosts")
  societies             Society[]              @relation("CreatorOfSociety")
  societyMemberships    SocietyMembership[]
  societyPosts          SocietyPost[]
  societyPostComments   SocietyPostComment[]
  societyPostLikes      SocietyPostLike[]
  societyPostShares     SocietyPostShare[]
  assignedSteps         Step[]                 @relation("AssigneeOfStep")
  createdSteps          Step[]                 @relation("CreatorOfStep")
  createdUpdates        Update[]               @relation("CreatorOfUpdate")
  userFollowers         UserFollow[]           @relation("UserFollowers")
  userFollowing         UserFollow[]           @relation("UserFollowing")
  topicInterests        UserTopicInterest[]    @relation("UserTopicInterests")
  chatReactions         ChatMessageReaction[]  @relation("UserChatReactions")
}

model Initiative {
  id                 String                 @id @default(cuid())
  title              String
  description        String
  imageUrl           String?
  roles              String[]               @default([])
  status             InitiativeStatus
  createdAt          DateTime               @default(now())
  creatorId          String
  aiGuidance         String?
  updatedAt          DateTime?              @updatedAt
  location           String?
  latitude           Float?
  longitude          Float?
  progress           Int?
  showLocation       Boolean                @default(true)
  societyId          String?
  originatingIdeaId  String?                @unique
  originatingIssueId String?                @unique
  actions            Action[]
  chatMessages       ChatMessage[]
  linkedPosts        GeneralPost[]          @relation("LinkedInitiativePosts")
  goals              Goal[]
  championedIdea     Idea?                  @relation("ChampionedIdea")
  originatingIdea    Idea?                  @relation("InitiativeFromIdea")
  creator            User                   @relation("CreatorOfInitiative", fields: [creatorId], references: [id])
  society            Society?               @relation(fields: [societyId], references: [id])
  memberships        InitiativeMembership[]
  originatingIssue   Issue?                 @relation("InitiativeAddressingIssue")
  championedIssue    Issue?                 @relation("ChampionedIssue")
  milestones         Milestone[]
  steps              Step[]
  updates            Update[]
}

model Milestone {
  id           String          @id @default(cuid())
  initiativeId String
  title        String
  description  String?
  status       MilestoneStatus
  order        Int?
  createdAt    DateTime        @default(now())
  creatorId    String
  dueDate      DateTime?
  creator      User            @relation("CreatorOfMilestone", fields: [creatorId], references: [id])
  initiative   Initiative      @relation(fields: [initiativeId], references: [id])
  steps        Step[]
}

model Step {
  id           String     @id @default(cuid())
  initiativeId String
  milestoneId  String
  title        String
  description  String?
  status       StepStatus
  assigneeId   String?
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  creatorId    String
  completedAt  DateTime?
  assignee     User?      @relation("AssigneeOfStep", fields: [assigneeId], references: [id])
  creator      User       @relation("CreatorOfStep", fields: [creatorId], references: [id])
  initiative   Initiative @relation(fields: [initiativeId], references: [id])
  milestone    Milestone  @relation(fields: [milestoneId], references: [id])
}

model ChatMessage {
  id           String              @id @default(cuid())
  initiativeId String?
  senderId     String
  senderName   String
  text         String              // Can contain plain text OR JSON-encoded rich media (images, files, etc)
  timestamp    DateTime            @default(now())
  receiverId   String?
  initiative   Initiative?         @relation(fields: [initiativeId], references: [id])
  receiver     User?               @relation("ReceiverOfChatMessage", fields: [receiverId], references: [id])
  sender       User                @relation("SenderOfChatMessage", fields: [senderId], references: [id])
  reactions    ChatMessageReaction[]
}

model ChatMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation("UserChatReactions", fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
}

model MediaItem {
  id       String       @id @default(cuid())
  url      String
  type     MediaType
  updateId String?
  postId   String?
  ideaId   String?
  issueId  String?
  idea     Idea?        @relation("IdeaMedia", fields: [ideaId], references: [id])
  issue    Issue?       @relation("IssueMedia", fields: [issueId], references: [id])
  post     GeneralPost? @relation(fields: [postId], references: [id])
  update   Update?      @relation(fields: [updateId], references: [id])
}

model Update {
  id           String      @id @default(cuid())
  initiativeId String
  type         UpdateType
  userId       String
  content      String
  details      Json?
  createdAt    DateTime    @default(now())
  goalId       String?
  updatedAt    DateTime?   @updatedAt
  media        MediaItem[]
  goal         Goal?       @relation("GoalUpdates", fields: [goalId], references: [id])
  initiative   Initiative  @relation(fields: [initiativeId], references: [id])
  user         User        @relation("CreatorOfUpdate", fields: [userId], references: [id])
}

model GeneralPost {
  id                 String                @id @default(cuid())
  creatorId          String
  creatorName        String
  creatorAvatar      String?
  content            String
  background         String?
  timestamp          DateTime              @default(now())
  linkedInitiativeId String?
  linkPreviewId      String?
  linkUrl            String?
  topics             String[]              @default([]) // Keep for backward compatibility during migration
  creator            User                  @relation("CreatorOfGeneralPost", fields: [creatorId], references: [id])
  linkPreview        LinkPreview?          @relation(fields: [linkPreviewId], references: [id])
  linkedInitiative   Initiative?           @relation("LinkedInitiativePosts", fields: [linkedInitiativeId], references: [id])
  comments           GeneralPostComment[]
  documents          GeneralPostDocument[]
  likes              GeneralPostLike[]
  links              GeneralPostLink[]
  shares             GeneralPostShare[]
  battleAsPost1      HotTakeBattle[]       @relation("BattlePost1")
  battleAsPost2      HotTakeBattle[]       @relation("BattlePost2")
  userHotTakePost    HotTakeParticipant[]  @relation("UserHotTakePost")
  relatedHotTakes    HotTakeRelatedPost[]  @relation("RelatedHotTakePost")
  media              MediaItem[]
  postTopics         PostTopic[]           @relation("PostTopics")

  @@index([topics])
}

model GeneralPostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      GeneralPost @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model GeneralPostShare {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      GeneralPost @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model GeneralPostComment {
  id              String               @id @default(cuid())
  postId          String
  userId          String
  text            String
  timestamp       DateTime             @default(now())
  parentCommentId String?
  parentComment   GeneralPostComment?  @relation("GeneralPostCommentThread", fields: [parentCommentId], references: [id])
  replies         GeneralPostComment[] @relation("GeneralPostCommentThread")
  post            GeneralPost          @relation(fields: [postId], references: [id])
  user            User                 @relation(fields: [userId], references: [id])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model ContributionItem {
  id                  String           @id @default(cuid())
  type                ContributionType
  title               String
  date                DateTime         @default(now())
  link                String?
  details             String?
  relatedInitiativeId String?
  relatedMilestoneId  String?
  relatedStepId       String?
  userId              String?
}

model Goal {
  id           String     @id @default(cuid())
  initiativeId String
  title        String
  description  String?
  ownerId      String?
  status       GoalStatus
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  priority     Priority?
  tags         String[]   @default([])
  ownerAvatar  String?
  ownerName    String?
  progress     Int?
  actions      Action[]
  initiative   Initiative @relation(fields: [initiativeId], references: [id])
  owner        User?      @relation("OwnerOfGoal", fields: [ownerId], references: [id])
  updates      Update[]   @relation("GoalUpdates")
}

model Action {
  id             String     @id @default(cuid())
  initiativeId   String
  goalId         String?
  title          String
  description    String?
  status         StepStatus
  assigneeId     String?
  assigneeName   String?
  assigneeAvatar String?
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  completedAt    DateTime?
  completedById  String?
  priority       Priority?
  creatorId      String?
  assignee       User?      @relation("AssigneeOfAction", fields: [assigneeId], references: [id])
  completedBy    User?      @relation("CompleterOfAction", fields: [completedById], references: [id])
  creator        User?      @relation("CreatorOfAction", fields: [creatorId], references: [id])
  goal           Goal?      @relation(fields: [goalId], references: [id])
  initiative     Initiative @relation(fields: [initiativeId], references: [id])
}

model InitiativeMembership {
  id           String             @id @default(cuid())
  userId       String
  initiativeId String
  role         InitiativeRoleType
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  customRole   String?
  initiative   Initiative         @relation(fields: [initiativeId], references: [id])
  user         User               @relation(fields: [userId], references: [id])

  @@unique([userId, initiativeId])
}

model Issue {
  id                       String         @id @default(cuid())
  title                    String
  description              String
  creatorId                String
  createdAt                DateTime       @default(now())
  tags                     String[]       @default([])
  location                 String?
  latitude                 Float?
  longitude                Float?
  championedByInitiativeId String?        @unique
  championCount            Int            @default(0)
  championedById           String?
  addressedByInitiativeId  String?        @unique
  societyId                String?
  relatedIdeas             Idea[]         @relation("IssueIdeas")
  addressedByInitiative    Initiative?    @relation("InitiativeAddressingIssue", fields: [addressedByInitiativeId], references: [id])
  championedBy             User?          @relation("ChampionedIssueBy", fields: [championedById], references: [id])
  championedByInitiative   Initiative?    @relation("ChampionedIssue", fields: [championedByInitiativeId], references: [id])
  creator                  User           @relation("CreatorOfIssue", fields: [creatorId], references: [id])
  society                  Society?       @relation("SocietyIssues", fields: [societyId], references: [id])
  comments                 IssueComment[]
  likes                    IssueLike[]
  shares                   IssueShare[]
  media                    MediaItem[]    @relation("IssueMedia")
}

model Idea {
  id                        String        @id @default(cuid())
  title                     String
  description               String
  creatorId                 String
  createdAt                 DateTime      @default(now())
  tags                      String[]      @default([])
  location                  String?
  latitude                  Float?
  longitude                 Float?
  championedByInitiativeId  String?       @unique
  championCount             Int           @default(0)
  championedById            String?
  addressingIssueId         String?
  implementedAsInitiativeId String?       @unique
  societyId                 String?
  addressingIssue           Issue?        @relation("IssueIdeas", fields: [addressingIssueId], references: [id])
  championedBy              User?         @relation("ChampionedIdeaBy", fields: [championedById], references: [id])
  championedByInitiative    Initiative?   @relation("ChampionedIdea", fields: [championedByInitiativeId], references: [id])
  creator                   User          @relation("CreatorOfIdea", fields: [creatorId], references: [id])
  implementedAsInitiative   Initiative?   @relation("InitiativeFromIdea", fields: [implementedAsInitiativeId], references: [id])
  society                   Society?      @relation("SocietyIdeas", fields: [societyId], references: [id])
  comments                  IdeaComment[]
  likes                     IdeaLike[]
  shares                    IdeaShare[]
  media                     MediaItem[]   @relation("IdeaMedia")
}

model IssueLike {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([issueId, userId])
}

model IssueShare {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([issueId, userId])
}

model IssueComment {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  text      String
  timestamp DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model IdeaLike {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([ideaId, userId])
}

model IdeaShare {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([ideaId, userId])
}

model IdeaComment {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  text      String
  timestamp DateTime @default(now())
  idea      Idea     @relation(fields: [ideaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  text      String
  timestamp DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id])
  User      User     @relation("UserComments", fields: [userId], references: [id])
}

model Post {
  id        String    @id @default(uuid())
  content   String
  creatorId String
  timestamp DateTime  @default(now())
  comments  Comment[]
  User      User      @relation("UserPosts", fields: [creatorId], references: [id])
}

model Society {
  id          String              @id @default(cuid())
  name        String
  description String?
  image       String?
  createdAt   DateTime            @default(now())
  creatorId   String
  location    String?
  latitude    Float?
  longitude   Float?
  ideas       Idea[]              @relation("SocietyIdeas")
  initiatives Initiative[]
  issues      Issue[]             @relation("SocietyIssues")
  creator     User                @relation("CreatorOfSociety", fields: [creatorId], references: [id])
  memberships SocietyMembership[]
  posts       SocietyPost[]
}

model SocietyMembership {
  id         String   @id @default(cuid())
  userId     String
  societyId  String
  role       String?
  customRole String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  society    Society  @relation(fields: [societyId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, societyId])
}

model SocietyPost {
  id            String                @id @default(cuid())
  societyId     String
  userId        String
  type          String
  content       String
  createdAt     DateTime              @default(now())
  imageUrl      String?
  linkPreviewId String?
  linkUrl       String?
  linkPreview   LinkPreview?          @relation(fields: [linkPreviewId], references: [id])
  society       Society               @relation(fields: [societyId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  comments      SocietyPostComment[]
  documents     SocietyPostDocument[]
  likes         SocietyPostLike[]
  links         SocietyPostLink[]
  shares        SocietyPostShare[]
}

model SocietyPostLike {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      SocietyPost @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model SocietyPostShare {
  id        String      @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime    @default(now())
  post      SocietyPost @relation(fields: [postId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model SocietyPostComment {
  id              String               @id @default(cuid())
  postId          String
  userId          String
  text            String
  createdAt       DateTime             @default(now())
  parentCommentId String?
  parentComment   SocietyPostComment?  @relation("CommentThread", fields: [parentCommentId], references: [id])
  replies         SocietyPostComment[] @relation("CommentThread")
  post            SocietyPost          @relation(fields: [postId], references: [id])
  user            User                 @relation(fields: [userId], references: [id])
}

model LinkPreview {
  id               String            @id @default(cuid())
  url              String            @unique
  title            String?
  description      String?
  image            String?
  siteName         String?
  favicon          String?
  type             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  generalPosts     GeneralPost[]
  generalPostLinks GeneralPostLink[]
  societyPosts     SocietyPost[]
  societyPostLinks SocietyPostLink[]
}

model SocietyPostLink {
  id            String      @id @default(cuid())
  postId        String
  linkPreviewId String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  linkPreview   LinkPreview @relation(fields: [linkPreviewId], references: [id], onDelete: Cascade)
  post          SocietyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, linkPreviewId])
  @@index([postId, order])
}

model GeneralPostLink {
  id            String      @id @default(cuid())
  postId        String
  linkPreviewId String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  linkPreview   LinkPreview @relation(fields: [linkPreviewId], references: [id], onDelete: Cascade)
  post          GeneralPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, linkPreviewId])
  @@index([postId, order])
}

model Document {
  id                   String                @id @default(cuid())
  url                  String                @unique
  filename             String
  fileType             String
  fileSize             Int
  extension            String
  title                String?
  description          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  generalPostDocuments GeneralPostDocument[]
  societyPostDocuments SocietyPostDocument[]
}

model SocietyPostDocument {
  id         String      @id @default(cuid())
  postId     String
  documentId String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  post       SocietyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, documentId])
  @@index([postId, order])
}

model GeneralPostDocument {
  id         String      @id @default(cuid())
  postId     String
  documentId String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  post       GeneralPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, documentId])
  @@index([postId, order])
}

model DebateTopic {
  id        String           @id @default(cuid())
  title     String
  content   String
  creatorId String
  imageUrl  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  arguments DebateArgument[]
  creator   User             @relation(fields: [creatorId], references: [id])
  votes     DebateVote[]
}

model DebateVote {
  id        String      @id @default(cuid())
  topicId   String
  userId    String
  side      DebateSide
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  topic     DebateTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([topicId, userId])
}

model DebateArgument {
  id        String               @id @default(cuid())
  topicId   String
  userId    String
  side      DebateSide
  content   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  parentId  String?
  parent    DebateArgument?      @relation("ArgumentThread", fields: [parentId], references: [id])
  replies   DebateArgument[]     @relation("ArgumentThread")
  topic     DebateTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id])
  votes     DebateArgumentVote[]
}

model DebateArgumentVote {
  id         String         @id @default(cuid())
  argumentId String
  userId     String
  isUpvote   Boolean
  createdAt  DateTime       @default(now())
  argument   DebateArgument @relation(fields: [argumentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])

  @@unique([argumentId, userId])
}

model Topic {
  id             String              @id @default(cuid())
  name           String              @unique
  description    String?
  category       String?             // e.g., "civic", "entertainment", "technology"
  isSystem       Boolean             @default(false) // True for auto-generated topics
  confidence     Float?              // Confidence score for auto-generated topics
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  postCount      Int                 @default(0)
  weeklyPosts    Int                 @default(0)
  popularInAreas String[]            @default([])
  userInterests  UserTopicInterest[] @relation("TopicUserInterests")
  postTopics     PostTopic[]         @relation("TopicPosts")

  @@index([name])
  @@index([postCount])
  @@index([category])
  @@index([isSystem])
}

model PostTopic {
  id         String      @id @default(cuid())
  postId     String
  topicId    String
  confidence Float?      // Confidence score for this topic assignment
  createdAt  DateTime    @default(now())
  post       GeneralPost @relation("PostTopics", fields: [postId], references: [id], onDelete: Cascade)
  topic      Topic       @relation("TopicPosts", fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([postId, topicId])
  @@index([postId])
  @@index([topicId])
}

model UserTopicInterest {
  id       String @id @default(cuid())
  userId   String
  topicId  String
  interest Float
  topic    Topic  @relation("TopicUserInterests", fields: [topicId], references: [id])
  user     User   @relation("UserTopicInterests", fields: [userId], references: [id])

  @@unique([userId, topicId])
}

model HotTakeBattle {
  id                String               @id @default(cuid())
  topic             String
  title             String
  description       String?
  status            HotTakeBattleStatus  @default(ACTIVE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  post1Id           String
  post2Id           String
  totalParticipants Int                  @default(0)
  post1Supporters   Int                  @default(0)
  post2Supporters   Int                  @default(0)
  neutralTakes      Int                  @default(0)
  location          String?
  post1             GeneralPost          @relation("BattlePost1", fields: [post1Id], references: [id], onDelete: Cascade)
  post2             GeneralPost          @relation("BattlePost2", fields: [post2Id], references: [id], onDelete: Cascade)
  participants      HotTakeParticipant[]
  relatedPosts      HotTakeRelatedPost[]

  @@index([topic])
  @@index([status])
  @@index([createdAt])
}

model HotTakeParticipant {
  id         String        @id @default(cuid())
  battleId   String
  userId     String
  stance     HotTakeStance
  createdAt  DateTime      @default(now())
  takePostId String?
  battle     HotTakeBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  takePost   GeneralPost?  @relation("UserHotTakePost", fields: [takePostId], references: [id])
  user       User          @relation("UserHotTakeParticipations", fields: [userId], references: [id])

  @@unique([battleId, userId])
  @@index([userId])
}

model HotTakeRelatedPost {
  id        String        @id @default(cuid())
  battleId  String
  postId    String
  stance    HotTakeStance
  createdAt DateTime      @default(now())
  battle    HotTakeBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  post      GeneralPost   @relation("RelatedHotTakePost", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([battleId, postId])
  @@index([battleId])
}

model NewsPost {
  id               String       @id @default(cuid())
  title            String
  summary          String
  excerpt          String?
  source           String
  sourceUrl        String
  imageUrl         String?
  publishedAt      DateTime
  location         String?
  city             String?
  urgencyLevel     Int          @default(1)
  tags             String[]     @default([])
  createdAt        DateTime     @default(now())
  triggeredActions NewsAction[]

  @@index([city])
  @@index([urgencyLevel])
  @@index([publishedAt])
  @@index([createdAt])
}

model NewsAction {
  id            String   @id @default(cuid())
  newsPostId    String
  userId        String
  actionType    String
  createdPostId String?
  createdAt     DateTime @default(now())
  newsPost      NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
  user          User     @relation("UserNewsActions", fields: [userId], references: [id])

  @@index([newsPostId])
  @@index([userId])
  @@index([actionType])
}

enum HotTakeBattleStatus {
  ACTIVE
  ARCHIVED
  ESCALATED_TO_ACTION
}

enum HotTakeStance {
  SUPPORT_POST1
  SUPPORT_POST2
  NEUTRAL
  CUSTOM_TAKE
}

enum InitiativeStatus {
  Idea
  Planning
  SeekingMembers
  InProgress
  Completed
}

enum MilestoneStatus {
  Planned
  InProgress
  Completed
  OnHold
}

enum StepStatus {
  ToDo
  InProgress
  Blocked
  InReview
  Done
}

enum UpdateType {
  join
  status
  post
  role_add
  milestone
  step_creation
  step_completion
  endorsement
  resource_share
  milestone_creation
  milestone_status
}

enum ContributionType {
  commit
  post_contribution
  comment
  initiative_join
  initiative_creation
  pull_request
  issue_comment
  code_commit
  post_creation
  step_completion
  resource_share
}

enum GoalStatus {
  NotStarted
  InProgress
  Completed
  Blocked
}

enum Priority {
  Low
  Medium
  High
}

enum MediaType {
  image
  video
}

enum InitiativeRoleType {
  ADMIN
